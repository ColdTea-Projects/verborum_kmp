<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CADisableMinimumFrameDurationOnPhone</key>
        <true/>
        <!-- The only ATS relaxation the app carries. NSAllowsLocalNetworking permits cleartext to
             loopback, .local and link-local addresses *only* — it can never allow http to a public
             host, so a release build stays https-only. It exists so a debug binary can reach the
             local Keycloak (:8180) and the local API gateway (:8080); see AuthConfig.ios.kt and
             ApiConfig.ios.kt, which pick those URLs on Platform.isDebugBinary. -->
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsLocalNetworking</key>
            <true/>
        </dict>
        <!-- The OAuth redirect scheme ASWebAuthenticationSession matches on; it must stay in sync
             with redirectUri in core/auth AuthConfig.ios.kt. -->
        <key>CFBundleURLTypes</key>
        <array>
            <dict>
                <key>CFBundleURLName</key>
                <string>de.coldtea.verborum.oauth</string>
                <key>CFBundleURLSchemes</key>
                <array>
                    <string>de.coldtea.verborum</string>
                </array>
            </dict>
        </array>
    </dict>
</plist>